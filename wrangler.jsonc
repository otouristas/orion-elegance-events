{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orion-elegance-events",
  "account_id": "3ae246eded35e99220b461c2ca5ff158",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "RESEND_FROM": "Κτήμα Ωρίων <requests@ktimaorion.gr>"
  },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
